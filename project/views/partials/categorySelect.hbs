<label for="category">Category:</label>
<select id="category" class="inputFields" name="category">
    <option value="">Select Category</option>
    {{#each categoryOptions}}
    <option value="{{value}}" {{isSelected}}>{{label}}</option>
    {{/each}}
</select>
{{#if errors}}
    {{#each errors}}
    <p class="error" style="color: rgb(164, 21, 21)">{{this}}</p>
    {{/each}}
{{/if}}